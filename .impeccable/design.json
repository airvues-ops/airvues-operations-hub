  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Emerald fill for the main action in a section (Add story, Send proposal).",
      "html": "<button class=\"ds-btn-primary\">Add story</button>",
      "css": ".ds-btn-primary{background:var(--emerald,#22D3A8);color:var(--bg,#0B0F17);font:600 12px/1.5 Manrope,system-ui,sans-serif;padding:6px 12px;border:0;border-radius:6px;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:rgba(34,211,168,.85)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--bg),0 0 0 4px rgba(34,211,168,.6);}"
    },
    {
      "name": "Delete Control",
      "kind": "button",
      "refersTo": "button-destructive-idle",
      "description": "The one destructive control: quiet bordered button that arms inline into a red confirm with consequence line.",
      "html": "<div class=\"ds-del\"><button class=\"ds-del-idle\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6\"/></svg>Delete</button><span class=\"ds-del-q\">Delete permanently?<small>Removes the story and its history.</small></span><button class=\"ds-del-confirm\">Yes, delete</button><button class=\"ds-del-cancel\">Cancel</button></div>",
      "css": ".ds-del{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font:12px/1.5 Manrope,system-ui,sans-serif}.ds-del-idle{display:inline-flex;gap:6px;align-items:center;background:transparent;border:1px solid var(--rule,#26303F);color:var(--ink-muted,#A3ADBD);padding:6px 12px;border-radius:6px;font:inherit;cursor:pointer;transition:color .15s,border-color .15s}.ds-del-idle:hover{border-color:rgba(251,113,133,.4);color:var(--red,#FB7185)}.ds-del-q{color:var(--ink-strong,#F8FAFC)}.ds-del-q small{display:block;font-size:11px;color:var(--ink-faint,#6B7585)}.ds-del-confirm{background:rgba(251,113,133,.15);border:1px solid rgba(251,113,133,.4);color:var(--red,#FB7185);font:500 12px/1.5 Manrope,system-ui,sans-serif;padding:6px 12px;border-radius:6px;cursor:pointer}.ds-del-confirm:hover{background:rgba(251,113,133,.25)}.ds-del-confirm:focus-visible,.ds-del-idle:focus-visible{outline:none;box-shadow:0 0 0 2px var(--bg,#0B0F17),0 0 0 4px rgba(251,113,133,.7)}.ds-del-cancel{background:none;border:0;color:var(--ink-faint,#6B7585);font:inherit;padding:6px 8px;cursor:pointer}.ds-del-cancel:hover{color:var(--ink-strong,#F8FAFC)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Elevated-ground field; border turns emerald on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Project name\">",
      "css": ".ds-input{background:var(--bg-elevated,#131825);color:var(--ink,#E8ECF2);border:1px solid var(--rule,#26303F);border-radius:6px;padding:6px 10px;font:12px/1.5 Manrope,system-ui,sans-serif;color-scheme:dark;transition:border-color .15s}.ds-input::placeholder{color:var(--ink-faint,#6B7585)}.ds-input:focus{outline:none;border-color:var(--emerald,#22D3A8)}"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "chip-status",
      "description": "Status word on its own 15% tint; colour follows the four meanings.",
      "html": "<span class=\"ds-chip ds-chip-done\">Completed</span> <span class=\"ds-chip ds-chip-flight\">In progress</span> <span class=\"ds-chip ds-chip-warn\">Owed</span>",
      "css": ".ds-chip{display:inline-flex;padding:2px 6px;border-radius:4px;font:500 11px/1.4 Manrope,system-ui,sans-serif}.ds-chip-done{background:rgba(34,211,168,.15);color:var(--emerald,#22D3A8)}.ds-chip-flight{background:rgba(125,211,252,.15);color:var(--sky,#7DD3FC)}.ds-chip-warn{background:rgba(251,191,36,.15);color:var(--amber,#FBBF24)}"
    },
    {
      "name": "Stage Section",
      "kind": "card",
      "refersTo": "stage-section",
      "description": "Forward section container: lifecycle mark, sentence-case title, folded summary, neutral 1px rule panel.",
      "html": "<section class=\"ds-stage\"><button class=\"ds-stage-h\" aria-expanded=\"true\"><span class=\"ds-mark ds-mark-current\"><i></i></span><h2>Proposal</h2><span class=\"ds-stage-sum\">Sent Sep 12 · 4 sections</span><svg class=\"ds-chev\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></button><div class=\"ds-stage-b\">Section body</div></section>",
      "css": ".ds-stage{background:var(--surface,#161C2A);border:1px solid var(--rule,#26303F);border-radius:8px;font-family:Manrope,system-ui,sans-serif}.ds-stage-h{display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px 10px 16px;background:none;border:0;text-align:left;cursor:pointer;border-radius:8px}.ds-stage-h:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(34,211,168,.6)}.ds-stage-h h2{margin:0;font-size:14px;font-weight:600;color:var(--ink-strong,#F8FAFC)}.ds-stage-sum{font-size:12.5px;color:var(--ink-muted,#A3ADBD);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-chev{margin-left:auto;color:var(--ink-faint,#6B7585)}.ds-mark{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;flex-shrink:0}.ds-mark-current{box-shadow:0 0 0 2px var(--surface,#161C2A),0 0 0 4px rgba(34,211,168,.7)}.ds-mark-current i{width:8px;height:8px;border-radius:50%;background:var(--emerald,#22D3A8)}.ds-stage-b{border-top:1px solid var(--rule,#26303F);padding:16px;font-size:13px;color:var(--ink,#E8ECF2)}"
    },
    {
      "name": "Stat Row",
      "kind": "custom",
      "refersTo": "stat-cell",
      "description": "Numbers band on 1px gap dividers; tabular sans values, colour only for status.",
      "html": "<dl class=\"ds-stats\"><div><dt>Project value</dt><dd class=\"v\">$24,000</dd></div><div><dt>Paid / owed</dt><dd class=\"v\"><span class=\"ok\">$12,000</span><span class=\"sl\"> / </span><span class=\"warn\">$12,000</span></dd><dd>Value − paid</dd></div><div><dt>Delivery due</dt><dd class=\"v\">Oct 20, 2026</dd><dd class=\"late\">3 days late</dd></div></dl>",
      "css": ".ds-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule,#26303F);border:1px solid var(--rule,#26303F);border-radius:8px;overflow:hidden;margin:0;font-family:Manrope,system-ui,sans-serif}.ds-stats>div{background:var(--surface,#161C2A);padding:12px 16px}.ds-stats dt{font-size:12px;color:var(--ink-muted,#A3ADBD)}.ds-stats dd{margin:4px 0 0;font-size:12px;color:var(--ink-muted,#A3ADBD)}.ds-stats dd.v{font-size:18px;font-weight:600;color:var(--ink-strong,#F8FAFC);font-variant-numeric:tabular-nums;line-height:1.25}.ds-stats .ok{color:var(--emerald,#22D3A8)}.ds-stats .warn{color:var(--amber,#FBBF24)}.ds-stats .sl{color:var(--ink-faint,#6B7585);font-weight:400}.ds-stats .late{color:var(--red,#FB7185);font-weight:500}"
    },
    {
      "name": "Sidebar Nav Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Active item on emerald-soft with a 2px emerald edge marker and emerald icon.",
      "html": "<nav class=\"ds-nav\"><a class=\"is-active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 12h18M3 6h18M3 18h12\"/></svg>Projects</a><a href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg>Earnings</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;background:var(--sidebar,#0D121C);padding:12px;font-family:Manrope,system-ui,sans-serif}.ds-nav a{position:relative;display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:6px;font-size:13px;color:var(--ink-muted,#A3ADBD);text-decoration:none;transition:all .15s}.ds-nav a svg{color:var(--ink-faint,#6B7585)}.ds-nav a:hover{color:var(--ink-strong,#F8FAFC);background:rgba(22,28,42,.6)}.ds-nav a:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(34,211,168,.6)}.ds-nav a.is-active{color:var(--ink-strong,#F8FAFC);background:rgba(34,211,168,.10)}.ds-nav a.is-active svg{color:var(--emerald,#22D3A8)}.ds-nav a.is-active::before{content:'';position:absolute;left:0;top:6px;bottom:6px;width:2px;border-radius:9999px;background:var(--emerald,#22D3A8)}"
